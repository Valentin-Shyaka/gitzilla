#!/usr/bin/env bash
# org: admin commands for an organization's gitzilla Worker. Runs in the org's profile only:
#   GITZILLA_PROFILE=<profile> bin/org approve <login> <fingerprint>
#   GITZILLA_PROFILE=<profile> bin/org revoke <login> [<fingerprint>]
#   GITZILLA_PROFILE=<profile> bin/org list
#   GITZILLA_PROFILE=<profile> bin/org allow-bot <login>
#   GITZILLA_PROFILE=<profile> bin/org disallow-bot <login>
# Each command is a POST /admin {payload: base64({cmd, args, ts, nonce}), sig} signed with this profile's push-note
# key (the admin key the Worker lists in ADMIN_PUBKEYS) in namespace gitzilla-admin.
# approve needs the fingerprint: anyone can ask to enroll under any login, so approve only the fingerprint the member
# gave you directly (the one ./install.sh --join-org printed for them). revoke without a fingerprint removes every
# key of that login and its pending requests; with one, only that key or request.
# Exit: 0 done, 1 the Worker refused or could not be reached (its error is printed), 2 usage / not in a profile.
# Env overrides (tests): GITZILLA_CURL.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
usage() {
  cat >&2 <<'EOF'
usage: GITZILLA_PROFILE=<org-profile> bin/org <command>
  approve <login> <fingerprint>   activate a pending key (fingerprint SHA256:..., given to you by the member)
  revoke <login> [<fingerprint>]  remove a member's keys (or one key) and their pending requests
  list                            members, pending requests (login, fingerprint, age) and allowed bots
  allow-bot <login>               let this bot's pushes through without a note (e.g. dependabot[bot])
  disallow-bot <login>            remove a bot from the allow-list
EOF
  exit 2
}
if [ -z "${GITZILLA_PROFILE:-}" ]; then
  echo "org: run in your org's gitzilla profile: GITZILLA_PROFILE=<org-profile> bin/org $*" >&2
  echo "org: (the personal profile has no admin commands; nothing was sent)" >&2
  exit 2
fi
. "$here/lib.sh"
CURL="${GITZILLA_CURL:-curl}"

die() { printf 'org: %s\n' "$*" >&2; exit 1; }

cmd="${1:-}"; [ $# -gt 0 ] && shift
login="" fp=""
case "$cmd" in
  approve)
    if [ $# -eq 1 ]; then
      echo "org: approve needs the key's fingerprint as well: bin/org approve <login> SHA256:..." >&2
      echo "org: ask the member for the fingerprint ./install.sh --join-org printed for them, directly (not from the request)" >&2
      exit 2
    fi
    [ $# -eq 2 ] || usage
    login="$1"; fp="$2" ;;
  revoke) { [ $# -eq 1 ] || [ $# -eq 2 ]; } || usage; login="$1"; fp="${2:-}" ;;
  list) [ $# -eq 0 ] || usage ;;
  allow-bot|disallow-bot) [ $# -eq 1 ] || usage; login="$1" ;;
  -h|--help|"") usage ;;
  *) echo "org: unknown command '$cmd'" >&2; usage ;;
esac
login="$(wd_lc "$login")"
case "$cmd" in
  approve|revoke) [[ $login =~ $WD_LOGIN_RE ]] || { echo "org: '$login' is not a GitHub login" >&2; exit 2; } ;;
  allow-bot|disallow-bot) [[ $login =~ $WD_BOT_RE ]] || { echo "org: '$login' is not a GitHub login or bot name" >&2; exit 2; } ;;
esac
if [ -n "$fp" ] && ! [[ $fp =~ $WD_FP_RE ]]; then
  echo "org: '$fp' is not a key fingerprint (SHA256: followed by 43 characters)" >&2; exit 2
fi
[ -n "${GITZILLA_URL:-}" ] || die "no Worker URL in $GITZILLA_CONFIG_DIR/config (profile $GITZILLA_PROFILE)"
[ -n "${GITZILLA_SIGN_KEY:-}" ] || [ -n "${NOTE_PUBKEY_FILE:-}" ] || die "no push-note key in $GITZILLA_CONFIG_DIR/config (profile $GITZILLA_PROFILE)"

case "$cmd" in
  approve) args="$(jq -cn --arg l "$login" --arg f "$fp" '{login:$l,fingerprint:$f}')" ;;
  revoke)  args="$(jq -cn --arg l "$login" --arg f "$fp" 'if $f == "" then {login:$l} else {login:$l,fingerprint:$f} end')" ;;
  list)    args='{}' ;;
  *)       args="$(jq -cn --arg l "$login" '{login:$l}')" ;;
esac

dir="$(mktemp -d)" || die "mktemp failed"
trap 'rm -rf "$dir"' EXIT
jq -cn --arg c "$cmd" --argjson a "$args" --argjson ts "$(date +%s)" --arg n "$(openssl rand -hex 16)" \
  '{cmd:$c,args:$a,ts:$ts,nonce:$n}' | tr -d '\n' > "$dir/payload"
[ -s "$dir/payload" ] || die "cannot build the request"
wd_envelope gitzilla-admin "$dir/payload" "$dir/body" || die "$WD_REASON (is Secretive running?)"
code="$("$CURL" --max-time 15 -sS -o "$dir/resp" -w '%{http_code}' -X POST -H 'Content-Type: application/json' \
        --data-binary @"$dir/body" "$GITZILLA_URL/admin" </dev/null 2>/dev/null)"
case "$code" in ""|000) die "cannot reach $GITZILLA_URL/admin" ;; esac
if [ "$code" != 200 ]; then
  err="$(jq -r '.error // empty' "$dir/resp" 2>/dev/null | tr -cd 'A-Za-z0-9 ._:/()[]-' | cut -c1-200)"
  wd_log "org: $cmd failed: ${err:-HTTP $code}"
  die "$cmd failed: ${err:-the Worker answered HTTP $code} (HTTP $code)"
fi
wd_log "org: $cmd ${login:+$login }${fp:+$fp }ok"

# age <unix-ts> -> "3d 4h", "5h 2m", "12m", "<1m"
age() {
  local s=$(( $(date +%s) - $1 ))
  [ "$s" -lt 0 ] && s=0
  if [ "$s" -ge 86400 ]; then printf '%dd %dh' $((s / 86400)) $((s % 86400 / 3600))
  elif [ "$s" -ge 3600 ]; then printf '%dh %dm' $((s / 3600)) $((s % 3600 / 60))
  elif [ "$s" -ge 60 ]; then printf '%dm' $((s / 60))
  else printf '<1m'; fi
}

case "$cmd" in
  approve) echo "approved: $login is a member with key $fp" ;;
  revoke)  if [ -n "$fp" ]; then echo "revoked: key $fp of $login (and its pending request, if any)"
           else echo "revoked: every key of $login and their pending requests"; fi ;;
  allow-bot) echo "allowed bot: $login (its pushes no longer alert)" ;;
  disallow-bot) echo "removed bot: $login" ;;
  list)
    jq -e '(.members|type)=="array" and (.pending|type)=="array" and (.bots|type)=="array"' "$dir/resp" >/dev/null 2>&1 \
      || die "unexpected answer from the Worker"
    clean='gsub("[^A-Za-z0-9._:/+\\[\\]-]"; "?")'
    echo "Members ($(jq '.members|length' "$dir/resp")):"
    if [ "$(jq '.members|length' "$dir/resp")" -eq 0 ]; then echo "  (none)"; else
      printf '  %-39s  %s\n' LOGIN FINGERPRINT
      jq -r ".members|sort_by(.login)[] | (.login|tostring|$clean) as \$l | (.fps // [])[] | [\$l, (tostring|$clean)] | @tsv" "$dir/resp" |
        while IFS="$(printf '\t')" read -r l f; do printf '  %-39s  %s\n' "$l" "$f"; done
    fi
    echo ""
    echo "Pending enrollments ($(jq '.pending|length' "$dir/resp")) — approve only a fingerprint the member gave you directly:"
    if [ "$(jq '.pending|length' "$dir/resp")" -eq 0 ]; then echo "  (none)"; else
      printf '  %-39s  %-50s  %s\n' LOGIN FINGERPRINT AGE
      jq -r ".pending|sort_by(.ts)[] | [(.login|tostring|$clean), (.fp|tostring|$clean), ((.ts // 0)|floor|tostring)] | @tsv" "$dir/resp" |
        while IFS="$(printf '\t')" read -r l f t; do
          case "$t" in ''|*[!0-9]*) t=0 ;; esac
          printf '  %-39s  %-50s  %s\n' "$l" "$f" "$(age "$t")"
        done
    fi
    echo ""
    echo "Allowed bots ($(jq '.bots|length' "$dir/resp")):"
    if [ "$(jq '.bots|length' "$dir/resp")" -eq 0 ]; then echo "  (none)"; else
      jq -r ".bots|sort[] | tostring|$clean" "$dir/resp" | while read -r b; do printf '  %s\n' "$b"; done
    fi ;;
esac
exit 0
