<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>@LABEL@</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>"@WATCHDOG_HOME@/bin/agent" poll; "@WATCHDOG_HOME@/bin/agent" health</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>WATCHDOG_STATE_DIR</key><string>@STATE@</string>
    <key>WATCHDOG_CONFIG_DIR</key><string>@CONFIG@</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>@STATE@/log/agent.out</string>
  <key>StandardErrorPath</key><string>@STATE@/log/agent.out</string>
</dict>
</plist>
